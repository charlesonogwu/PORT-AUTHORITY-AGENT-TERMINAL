# Build outputs
# NOTE: dist/src/ IS committed so `npm install -g github:...` skips the
# build entirely (prepare.cjs early-exits when dist/src/cli/index.js
# exists). dist/tests/ and the dashboard's own dist/ are still excluded.
dist/tests/
dashboard-ui/portpilot-dashboard/dist/
dashboard-ui/portpilot-dashboard/node_modules/
*.tsbuildinfo

# Dependencies
node_modules/

# Tauri build outputs (gui/) — bin/paat-dashboard.exe is what we ship,
# the intermediate compile artifacts stay out of git. Cargo.lock IS
# committed because paat-dashboard is a binary (reproducible builds).
gui/src-tauri/target/
gui/dist/
gui/node_modules/
gui/src-tauri/gen/


# Per-machine state (never committed)
.portpilot/
agent-lanes/
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/settings.local.json

# Internal AI planning / spec artifacts (the brainstorming + writing-plans
# skills write here). They contain local machine paths and dev-session notes,
# so they must never reach the public repo.
docs/superpowers/

# Environment / secrets
.env
.env.local
# Never commit npm auth tokens that may end up in a local .npmrc. The
# canonical location for the user's npm token is ~/.npmrc (outside the
# repo), but adding this guard means even an accidental write to a repo-
# local .npmrc can never be staged.
.npmrc

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Test outputs
coverage/
.nyc_output/
.tmp/

# npm / yarn
.npm/
.yarn/
*.tgz
yarn-error.log
npm-debug.log*

# Logs
*.log
logs/

# Chrome extension build artefacts
chrome-extension/icons/*.bak

# tsc -b output for Vite config (regenerated each build)
gui/vite.config.d.ts
gui/vite.config.js
gui/*.tsbuildinfo
